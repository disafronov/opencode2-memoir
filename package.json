{
  "name": "@zimniy/opencode2-memoir",
  "version": "0.1.0",
  "description": "Minimal Memoir integration for OpenCode V2",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "NOTICE.md",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@opencode/plugin": "2.4.1",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build:prompts": "node scripts/build-prompts.mjs",
    "build:types": "tsc --emitDeclarationOnly",
    "build:bundle": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node24 --external:@opencode/plugin --outfile=dist/index.js",
    "build": "npm run clean && npm run build:prompts && npm run build:types && npm run build:bundle",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests scripts",
    "format": "biome format --write src tests scripts",
    "test": "tsx --test --test-concurrency=1 --import ./tests/setup.ts tests/unit/*.test.ts",
    "test:integration": "npm run build && tsx --test --test-concurrency=1 --import ./tests/setup.ts tests/integration/*.test.ts",
    "test:all": "npm test && npm run test:integration && npm run test:package",
    "test:package": "node scripts/validate-package.mjs",
    "prepublishOnly": "npm run build",
    "test:unit": "npm test"
  },
  "keywords": [
    "opencode",
    "opencode2",
    "plugin",
    "memoir",
    "memory",
    "mcp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/disafronov/opencode2-memoir.git"
  },
  "bugs": {
    "url": "https://github.com/disafronov/opencode2-memoir/issues"
  },
  "homepage": "https://github.com/disafronov/opencode2-memoir#readme"
}
